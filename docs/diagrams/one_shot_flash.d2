...@styles

direction: right

mac: "" {
  grid-rows: 2
  class: block
  r: Mac { class: role }
  a: "fm flash --role <role> --device /dev/diskN" { class: art }
}

card: "" {
  grid-rows: 3
  class: block
  r: SD Card { class: role }
  p: "Ubuntu 22.04 Server (tegra)" { class: pkg }
  a: "seed swapped inside the rootfs" { class: art }
}

stick: "" {
  grid-rows: 3
  class: block
  r: USB Stick { class: role }
  p: "Ubuntu 26.04 Desktop (amd64)" { class: pkg }
  a: "autoinstall seed on CIDATA" { class: art }
}

boot: First Boot — Unattended {
  class: zoom
  ci: "" {
    grid-rows: 2
    class: block
    r: Machine Layer { class: role }
    a: "fm-setup --<role>" { class: art }
  }
  ws: "" {
    grid-rows: 2
    class: block
    r: Workspace Layer { class: role }
    a: "fm_ros2 --recorder | --processor" { class: art }
  }
  ci -> ws: gh token baked
}

machine: "" {
  grid-rows: 2
  class: block
  r: Rig Or Workstation { class: role }
  a: "provisioned on boot" { class: art }
}

mac -> card: --role jetson
mac -> stick: --role workstation
card -> boot: power on
stick -> boot: power on, confirm once
boot -> machine
