// fm-host-agent may start fm-host-disk-scan.service, and start, stop or restart
// fm-sim-agent.service, and that is all.
//
// The agent runs unprivileged as fm-host. Every other systemd action it asks
// for falls through to polkit's defaults, which refuse an account with no
// session to authenticate in. Installed as is by fm-setup's 93-host-agent.sh.
// A host without the sim agent unit has nothing for the second clause to match.
polkit.addRule(function (action, subject) {
  if (action.id !== "org.freedesktop.systemd1.manage-units" || subject.user !== "fm-host") {
    return polkit.Result.NOT_HANDLED;
  }
  var unit = action.lookup("unit");
  var verb = action.lookup("verb");
  if (unit === "fm-host-disk-scan.service" && verb === "start") {
    return polkit.Result.YES;
  }
  if (unit === "fm-sim-agent.service" &&
      (verb === "start" || verb === "stop" || verb === "restart")) {
    return polkit.Result.YES;
  }
  return polkit.Result.NOT_HANDLED;
});
